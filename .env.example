# Copy to .env and fill in. .env is gitignored — verify with: git check-ignore -v .env
#
# ─────────────────────────────────────────────────────────────────────────────
# NOTE ON KEYS: there is no PRIVATE_KEY here, on purpose.
# Use an encrypted foundry keystore instead, so the deploy key is never in a
# file, never in shell history and never in an environment variable:
#
#   cast wallet import chipworks-deployer --interactive     # paste key ONCE
#   cast wallet list                                        # confirm it exists
#   cast wallet address --account chipworks-deployer        # == DEPLOY_WALLET
#
# then pass --account chipworks-deployer to every forge script command.
# ─────────────────────────────────────────────────────────────────────────────

# Base mainnet archive RPC (Alchemy / QuickNode / your own node).
# Fork tests need archive access; the public https://mainnet.base.org WILL rate-limit.
BASE_RPC_URL=

# Optional, for `forge verify-contract`
BASESCAN_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# DEPLOY INPUTS — fill in before running script/Deploy.s.sol
# ═════════════════════════════════════════════════════════════════════════════

# --- Addresses you choose -----------------------------------------------------
# The Safe that owns all twelve contracts from their first block. Must be a
# CONTRACT — the script refuses an EOA here.
MULTISIG=0xe1096B727499a3f70FaD8bc0267F5e69d01373C7
# Receives the 20% ops share of every fee. Goya's Bankr wallet.
OPS_WALLET=0x35325dD7e972780C3aDef20E9675a4264a8a57fb
# Where liquidated NounLoans collateral lands. May be the Safe.
LOAN_TREASURY=0xe1096B727499a3f70FaD8bc0267F5e69d01373C7
# Runs the daily keeper jobs. Permissionless work, so this is operational only.
# Also becomes POLTreasury.manager.
KEEPER=0x6571E3412553Fada40C3D96e61E7Cfd20A0695B9

# The signer that runs script/Deploy.s.sol. Not used by the deploy script itself
# (forge takes it via --account), but VerifyOwnership reads it to prove nothing
# was left in its hands.
DEPLOY_WALLET=0x9FD4A40f7bE01CB69b7286cEC43D3d5936980Ad4

# --- Addresses that come from elsewhere ---------------------------------------
# $CHIP, from the Bankr/Doppler launch. Unknown until launch day.
CHIP=
BASED_NOUNS=
DARK_NOUNS=
# Known and verified on chain — no need to change these:
#   LIL_NOUNS  0xe3c5Ef27B80481518a2363406e354a9361415556
#   CHIPLETS   0xC7c114191aa3b2225F9bb053Bc55b3d6F145Bd33

# --- Numbers, all in WEI (18 decimals) — LOCKED 2026-09-08 -------------------
# Implied $CHIP price from the loan seed ($700 / 467,000,000) = $0.000001499
#
# Base unit 5,000,000 CHIP = $7.49 — that is 1.5x the $5 target, i.e. the
# deliberate HIGH bias. Too expensive is recoverable in a later 48h window;
# too cheap burns $CHIP that cannot be un-burned.
CHIP_BASE_UNIT=5000000000000000000000000

# Tier ladder is DERIVED from the base by SafeCallsPhase3Costs (x1.0/2.2/4.5/9.0/24.0):
#   tier 0    5,000,000  = $  7.49
#   tier 1   11,000,000  = $ 16.49
#   tier 2   22,500,000  = $ 33.73
#   tier 3   45,000,000  = $ 67.45
#   tier 4  120,000,000  = $179.87

# Chiplet flat activation, five EQUAL entries. Stated explicitly, not derived.
# NOTE: 2,000,000 is 40% of base, not the documented 10% (500,000). At 10% a
# Chiplet sits at parity with a Based Noun on cost-per-earning; at 40% it costs
# ~4x more per unit of earning weight. Deliberate — high is the safe direction.
CHIPLET_FLAT_CHIP=2000000000000000000000000

# 10% of base
SPLIT_FEE_CHIP=500000000000000000000000
# 0.5x base — placeholder, recipe ships PAUSED
FURNACE_BASED_CHIP_COST=2500000000000000000000000
# 1.2x base — placeholder, recipe ships PAUSED
FURNACE_DARK_CHIP_COST=6000000000000000000000000

# --- Anvil, in ETH wei. Independent of $CHIP price. ------------------------
# 0.011 ETH = ~$27.40 at ETH $2,491
ANVIL_QUEUE_PRICE_WEI=11000000000000000

# --- Seeding, entered by hand in the Safe ----------------------------------
# Loan pool seed              467,000,000 CHIP = $700
#   467000000000000000000000000
# maxPrincipal — OPTION B, availability over size. setMaxPrincipal is INSTANT
# (no timelock), so these rise as the pool grows.
#   Based  2,000,000 CHIP = $3.00   -> 233 concurrent loans against a 467M pool
#   Dark   8,000,000 CHIP = $12.00  ->  58 concurrent
#   Lil    1,000,000 CHIP = $1.50   -> 467 concurrent
#   2000000000000000000000000
#   8000000000000000000000000
#   1000000000000000000000000

# --- Filled in AS YOU GO, from each phase's output ----------------------------
# Phase 1 prints these:
FEE_SPLITTER=
STOCK_REGISTRY=
POT=
POL_TREASURY=
# Phase 2 prints this:
CHIP_BURNER=
# Phase 3 prints this:
CHIP_ACTIVATION=
# Phase 4 prints these:
CHIP_CLAIMS=
CHIP_ROUNDS=
CLAIM_ROUTER=
FURNACE=
NOUN_LOANS=
ANVIL=
