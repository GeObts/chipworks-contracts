# Copy to .env and fill in. .env is gitignored — verify with: git check-ignore -v .env
#
# ─────────────────────────────────────────────────────────────────────────────
# NOTE ON KEYS: there is no PRIVATE_KEY here, on purpose.
# Use an encrypted foundry keystore instead, so the deploy key is never in a
# file, never in shell history and never in an environment variable:
#
#   cast wallet import chipworks-deployer --interactive     # paste key ONCE
#   cast wallet list                                        # confirm it exists
#   cast wallet address --account chipworks-deployer        # == DEPLOY_WALLET
#
# then pass --account chipworks-deployer to every forge script command.
# ─────────────────────────────────────────────────────────────────────────────

# Base mainnet archive RPC (Alchemy / QuickNode / your own node).
# Fork tests need archive access; the public https://mainnet.base.org WILL rate-limit.
BASE_RPC_URL=

# Optional, for `forge verify-contract`
BASESCAN_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# DEPLOY INPUTS — fill in before running script/Deploy.s.sol
# ═════════════════════════════════════════════════════════════════════════════

# --- Addresses you choose -----------------------------------------------------
# The Safe that owns all twelve contracts from their first block. Must be a
# CONTRACT — the script refuses an EOA here.
MULTISIG=0xe1096B727499a3f70FaD8bc0267F5e69d01373C7
# Receives the 20% ops share of every fee. Goya's Bankr wallet.
OPS_WALLET=0x35325dD7e972780C3aDef20E9675a4264a8a57fb
# Where liquidated NounLoans collateral lands. May be the Safe.
LOAN_TREASURY=0xe1096B727499a3f70FaD8bc0267F5e69d01373C7
# Runs the daily keeper jobs. Permissionless work, so this is operational only.
# Also becomes POLTreasury.manager. STILL TBD.
KEEPER=

# The signer that runs script/Deploy.s.sol. Not used by the deploy script itself
# (forge takes it via --account), but VerifyOwnership reads it to prove nothing
# was left in its hands.
DEPLOY_WALLET=0x9FD4A40f7bE01CB69b7286cEC43D3d5936980Ad4

# --- Addresses that come from elsewhere ---------------------------------------
# $CHIP, from the Bankr/Doppler launch. Unknown until launch day.
CHIP=
BASED_NOUNS=
DARK_NOUNS=
# Known and verified on chain — no need to change these:
#   LIL_NOUNS  0xe3c5Ef27B80481518a2363406e354a9361415556
#   CHIPLETS   0xC7c114191aa3b2225F9bb053Bc55b3d6F145Bd33

# --- Numbers, all in WEI (18 decimals) ----------------------------------------
# The tier-0 activation cost: the round number nearest $5 at the price observed
# over 24–48h. 50,000 $CHIP would be 50000000000000000000000.
# EVERY other number below is derived from this one.
CHIP_BASE_UNIT=
# 10% of the base unit. At a 50,000 base: 5000000000000000000000
SPLIT_FEE_CHIP=
# 0.5x the base unit — the Furnace Based recipe. At 50,000 base: 25,000
FURNACE_BASED_CHIP_COST=
# 1.2x the base unit — the Furnace Dark recipe. At 50,000 base: 60,000
FURNACE_DARK_CHIP_COST=

# --- Filled in AS YOU GO, from each phase's output ----------------------------
# Phase 1 prints these:
FEE_SPLITTER=
STOCK_REGISTRY=
POT=
POL_TREASURY=
# Phase 2 prints this:
CHIP_BURNER=
# Phase 3 prints this:
CHIP_ACTIVATION=
# Phase 4 prints these:
CHIP_CLAIMS=
CHIP_ROUNDS=
CLAIM_ROUTER=
FURNACE=
NOUN_LOANS=
ANVIL=
